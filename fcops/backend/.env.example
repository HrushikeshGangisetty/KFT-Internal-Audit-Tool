# Copy to .env and fill in. NEVER commit .env — it is in .gitignore.
# Only the Django backend reads this file. Nothing here is exposed to React.

# =============================================================================
# Database
# =============================================================================
# Provide EITHER a single DATABASE_URL (recommended — this is what Supabase
# gives you) OR the individual POSTGRES_* variables below. If DATABASE_URL is
# set it wins and the POSTGRES_* values are ignored.
#
# --- Supabase (shared database used by the whole team) -----------------------
# Supabase dashboard -> Project Settings -> Database -> Connection string ->
# choose "Session pooler" and the URI tab.
#
# Use the SESSION POOLER (port 5432). It is reachable over IPv4 and supports
# everything Django needs: migrations, prepared statements, server-side cursors
# and CREATE DATABASE. Its username has the project ref appended to "postgres".
#
#   DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-<n>-<region>.pooler.supabase.com:5432/postgres
#
# Do NOT use db.<project-ref>.supabase.co — Supabase serves that host over IPv6
# only, so it times out on most IPv4 networks.
#
# The transaction pooler (same host, port 6543) also works for serving traffic;
# the app detects the port and automatically disables persistent connections and
# server-side cursors. Do not run migrations through it.
#
# If your password contains @ : / ? # or %, percent-encode it in the URL
# (@ -> %40, : -> %3A, / -> %2F, # -> %23, % -> %25).
DATABASE_URL=

# --- Local PostgreSQL alternative (used when DATABASE_URL is empty) ----------
POSTGRES_DB=fcops
POSTGRES_USER=fcops
POSTGRES_PASSWORD=
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# TLS. Defaults to "require" for any remote host and "disable" for localhost,
# so you normally do not need to set this.
# DB_SSLMODE=require

# --- Connection lifetime (read this before changing it) ----------------------
# Defaults to 0 for remote hosts and 60 for localhost.
#
# Django's dev server (`runserver`) creates a NEW THREAD PER REQUEST and each
# thread opens its own database connection. With a persistent connection
# lifetime those pile up until Supabase refuses new clients with
# "max clients reached in session mode - pool_size: 15". Leaving this at 0
# against a remote pooler is what keeps that from happening.
#
# Raise it ONLY when running under a WSGI server with a bounded thread pool,
# e.g. waitress with --threads=6 (see README -> Connection limits).
# DB_CONN_MAX_AGE=60
# DB_CONNECT_TIMEOUT=10
# DB_APPLICATION_NAME=fcops-django

# --- Optional: separate connection for schema changes ------------------------
# If DATABASE_URL points at the TRANSACTION pooler (port 6543), migrations need
# a real session. Point this at the SESSION pooler (port 5432); it is used
# automatically for migrate / makemigrations / dbcheck.
# MIGRATION_DATABASE_URL=

# --- Test database -----------------------------------------------------------
# The test suite CREATES, POPULATES and DROPS a database, so it must never run
# against the shared Supabase instance. If DATABASE_URL points at a remote host
# and nothing below is set, tests automatically fall back to local PostgreSQL.
# TEST_DATABASE_URL=postgresql://fcops:<password>@127.0.0.1:5432/fcops
# ALLOW_TESTS_ON_REMOTE_DB=False

# =============================================================================
# Django
# =============================================================================
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
LOG_LEVEL=INFO
TIME_ZONE=Asia/Kolkata

# =============================================================================
# JWT
# =============================================================================
JWT_ACCESS_MINUTES=120
JWT_REFRESH_DAYS=7

# =============================================================================
# CORS / CSRF — origins the React dev server runs on
# =============================================================================
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# =============================================================================
# Attachments — local filesystem for now (no object storage yet)
# =============================================================================
MEDIA_ROOT=./media

# =============================================================================
# Domain policy toggles
# =============================================================================
REQUIRE_INDEPENDENT_VERIFICATION=True
ALLOW_MANAGER_DEVIATION=True
